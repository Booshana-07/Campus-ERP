# Optional. If left blank or the request fails, the app automatically
# uses the built-in deterministic fallback classifier — the app always works.
GROQ_API_KEY=

# Free Groq model used for classification (only used if GROQ_API_KEY is set)
GROQ_MODEL=llama-3.1-8b-instant

# ----- Phase 3A: authentication -----
# Secret used to sign session tokens. Leave blank in development and one will be
# generated and stored in backend/.sensora_secret (gitignored). Set an explicit
# value for any real deployment. Changing it signs everyone out.
SENSORA_SECRET_KEY=

# How long a login session lasts before the user must sign in again.
SENSORA_TOKEN_EXPIRY_HOURS=12

# Password given to the three seeded demo accounts, and to any pre-Phase-3A
# account that is backfilled during migration. Change it for any shared demo.
DEMO_USER_PASSWORD=Campus@2025
